{
  "name": "dsh-status-box",
  "version": "1.2.0",
  "private": false,
  "type": "module",
  "description": "Status bar companion for DeepSeek Harness on macOS and Windows: a persistent tray/menu-bar whale shows running and waiting sessions per workspace, and one global hotkey starts a new task from a native capture window.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "menubar/main.m",
    "menubar/whale.png",
    "menubar/build.sh",
    "menubar/install.sh",
    "menubar/uninstall.sh",
    "README.md",
    "windows/build.ps1",
    "windows/install.ps1",
    "windows/uninstall.ps1",
    "windows/README.md",
    "windows/src/**/*.cs",
    "windows/src/**/*.csproj",
    "windows/src/**/*.manifest",
    "windows/src/**/*.png",
    "windows/tests/**/*.cs",
    "windows/tests/**/*.csproj"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "license": "MIT",
  "author": "mxw",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "macos",
    "menubar",
    "status-bar",
    "task-capture"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nuke0519/dsh-status-box.git"
  },
  "homepage": "https://github.com/Nuke0519/dsh-status-box#readme",
  "bugs": {
    "url": "https://github.com/Nuke0519/dsh-status-box/issues"
  },
  "scripts": {
    "build:menubar": "bash menubar/build.sh",
    "install:menubar": "bash menubar/install.sh",
    "uninstall:menubar": "bash menubar/uninstall.sh",
    "test": "node --test tests/*.cjs",
    "build:windows": "dotnet publish windows/src/DSHStatusBox.App -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:EnableCompressionInSingleFile=true -o dist/win-x64",
    "test:windows": "dotnet run --project windows/tests/BridgeSmoke -c Release",
    "verify": "bash scripts/verify.sh",
    "verify:windows": "pwsh -File scripts/verify.ps1"
  }
}
