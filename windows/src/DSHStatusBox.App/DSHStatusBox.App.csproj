<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DSHStatusBox</AssemblyName>
    <RootNamespace>DSHStatusBox.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- allow publishing a win-x64 binary from macOS/Linux CI -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Product>DSH Status Box</Product>
    <Description>Menu-bar style status + quick task capture for DeepSeek Harness on Windows.</Description>
    <Version>1.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DSHStatusBox.Core\DSHStatusBox.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="whale.png" />
  </ItemGroup>

</Project>
